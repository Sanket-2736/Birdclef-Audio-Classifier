# Database
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/birdclef
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/dbname
# For MySQL: DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Storage
STORAGE_ROOT=storage
MAX_UPLOAD_MB=100
ALLOWED_AUDIO_EXTENSIONS=wav,ogg,mp3,flac

# Application
DEBUG=True
